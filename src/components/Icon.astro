---
import type { IconName } from '../data/site';

interface Props {
	name:
		| IconName
		| 'check'
		| 'mail'
		| 'phone'
		| 'pin'
		| 'clock'
		| 'arrow'
		| 'tag'
		| 'file'
		| 'twitter'
		| 'instagram'
		| 'linkedin'
		| 'facebook';
	size?: number;
}

const { name, size = 24 } = Astro.props;

const paths: Record<Props['name'], string> = {
	globe:
		'<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z"/>',
	ship: '<path d="M3 17l2 4h14l2-4"/><path d="M5 17V9h14v8"/><path d="M9 9V5h6v4"/><path d="M12 9v8"/>',
	shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9c-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2l4-4"/>',
	box: '<path d="M21 8l-9-5l-9 5v8l9 5l9-5z"/><path d="M3 8l9 5l9-5"/><path d="M12 13v8"/>',
	search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>',
	chart: '<path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/>',
	check: '<path d="M5 12l5 5l9-10"/>',
	mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6l9-6"/>',
	phone:
		'<path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
	pin: '<path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>',
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	arrow: '<path d="M5 12h14"/><path d="M13 6l6 6l-6 6"/>',
	twitter:
		'<path d="M4 4h4.5l11.5 16h-4.5z"/><path d="M19.5 4l-6.6 7.3"/><path d="M4.5 20l6.6-7.3"/>',
	instagram:
		'<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none"/>',
	linkedin:
		'<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 11v5"/><path d="M8 7.5v.01"/><path d="M12 16v-5"/><path d="M16 16v-3a2 2 0 0 0-4 0"/>',
	facebook:
		'<path d="M15 3h-2a4 4 0 0 0-4 4v3H7v4h2v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2z"/>',
	file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h6"/>',
	tag: '<path d="M3 4.5V11l9.3 9.3a1.6 1.6 0 0 0 2.3 0l5.7-5.7a1.6 1.6 0 0 0 0-2.3L11 3H4.5A1.5 1.5 0 0 0 3 4.5z"/><circle cx="7.5" cy="7.5" r="1.4"/>',
};
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={paths[name]}
/>
