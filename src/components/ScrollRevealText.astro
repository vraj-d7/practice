---
interface Props {
	/** Opening words shown in bold, e.g. the company name. */
	lead?: string;
	text: string;
	/** Optional small link shown in a column to the left of the text. */
	link?: { href: string; label: string };
}

const { lead = '', text, link } = Astro.props;
const leadWords = lead.split(/\s+/).filter(Boolean);
const textWords = text.split(/\s+/).filter(Boolean);
---

<section class="section reveal-text-section">
	<div class:list={['container', { 'reveal-text-grid': link }]}>
		{link && <a href={link.href} class="reveal-text-link reveal">{link.label}</a>}
		<p class="reveal-text reveal" data-reveal-text>
			<span class="sr-only">{lead} {text}</span>
			{/* Each letter is wrapped so it can light up on its own. Letters are grouped by
			   word so lines still only break between words. */}
			<span aria-hidden="true">
				{
					leadWords.map((word) => (
						<strong class="word">
							{[...word].map((ch) => (
								<span class="ch">{ch}</span>
							))}{' '}
						</strong>
					))
				}
				{
					textWords.map((word) => (
						<span class="word">
							{[...word].map((ch) => (
								<span class="ch">{ch}</span>
							))}{' '}
						</span>
					))
				}
			</span>
		</p>
	</div>
</section>

<script>
	// Light up each letter in turn as the paragraph scrolls through the screen.
	const blocks = document.querySelectorAll<HTMLElement>('[data-reveal-text]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	blocks.forEach((block) => {
		if (reduceMotion) return;
		block.classList.add('is-animated');
		const letters = block.querySelectorAll<HTMLElement>('.ch');
		let lastLit = -1;

		// Where the text sits on the page, so it still starts unlit on tall screens
		// where it's already in view when the page loads.
		const pageTop = block.getBoundingClientRect().top + window.scrollY;

		const update = () => {
			const rect = block.getBoundingClientRect();
			const vh = window.innerHeight;
			// Starts when the top of the text reaches 80% down the screen and finishes
			// when the bottom of the text reaches the middle of the screen.
			const start = Math.min(vh * 0.8, pageTop);
			const end = vh * 0.5;
			const progress = (start - rect.top) / (start - end + rect.height);
			const lit = Math.round(Math.min(Math.max(progress, 0), 1) * letters.length);
			if (lit === lastLit) return;

			// Only touch the letters that changed since the last update.
			const from = Math.min(lit, Math.max(lastLit, 0));
			const to = Math.max(lit, lastLit);
			for (let i = from; i < to; i++) letters[i].classList.toggle('lit', i < lit);
			lastLit = lit;
		};

		letters.forEach((letter) => letter.classList.remove('lit'));
		update();
		window.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
	});
</script>

<style>
	.reveal-text {
		max-width: 1000px;
		margin: 0 auto;
		font-size: clamp(1.3rem, 2.6vw, 2.1rem);
		font-weight: 500;
		line-height: 1.35;
		letter-spacing: -0.02em;
		color: var(--navy);
	}

	.reveal-text strong {
		font-weight: 800;
	}

	/* Link on the left, text on the right */
	.reveal-text-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
		gap: 3rem;
		align-items: start;
	}

	.reveal-text-grid .reveal-text {
		max-width: none;
		margin: 0;
	}

	.reveal-text-link {
		justify-self: start;
		margin-top: 0.4rem;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--text-muted);
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color 0.3s var(--ease-smooth);
	}

	.reveal-text-link:hover {
		color: var(--accent);
	}

	@media (max-width: 900px) {
		.reveal-text-grid {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* Letters start pale and turn navy once reached. Without JavaScript, or with
	   reduced motion, the whole paragraph simply shows in navy. */
	.reveal-text.is-animated .ch {
		color: #c9d4e2;
		transition: color 0.3s var(--ease-smooth);
	}

	.reveal-text.is-animated .ch.lit {
		color: var(--navy);
	}
</style>
