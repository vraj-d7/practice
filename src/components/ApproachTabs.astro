---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ComponentProps } from 'astro/types';

type IconName = ComponentProps<typeof Icon>['name'];

interface Step {
	name: string;
	text: string;
	/** Shown in the placeholder until a photo is added. */
	icon: IconName;
	photo?: ImageMetadata;
	/** Which part of the photo to keep when it's cropped, e.g. 'center 55%'. */
	photoPosition?: string;
	/** 'contain' shows the whole photo (with a blurred fill behind it) instead of
	    cropping it to the frame. Useful for tall photos. */
	fit?: 'cover' | 'contain';
}

interface Props {
	eyebrow: string;
	title: string;
	steps: Step[];
	/** Seconds each tab stays before moving to the next. */
	interval?: number;
	/** Use the light blue-grey section background (#f5f8fb) instead of white. */
	soft?: boolean;
}

const { eyebrow, title, steps, interval = 5, soft = false } = Astro.props;
const id = 'approach';
---

<section class:list={['section', { 'section-soft': soft }]}>
	<div class="container">
		<div class="approach-head reveal">
			<span class="eyebrow">{eyebrow}</span>
			<h2>{title}</h2>
		</div>

		<div class="tabs reveal" data-tabs style={`--interval: ${interval}s`}>
			<div class="tab-media" aria-hidden="true">
				{
					steps.map((step, i) => (
						<div
							class:list={['tab-photo', { 'is-active': i === 0, 'is-contain': step.fit === 'contain' }]}
							data-photo
						>
							{step.photo && step.fit === 'contain' ? (
								<>
									<Image src={step.photo} alt="" width={240} class="photo-fill" />
									<Image
										src={step.photo}
										alt=""
										width={900}
										widths={[500, 900]}
										sizes="(max-width: 900px) 70vw, 420px"
										class="photo-main"
									/>
								</>
							) : step.photo ? (
								<Image
									src={step.photo}
									alt=""
									width={1100}
									widths={[700, 1100]}
									sizes="(max-width: 900px) 100vw, 640px"
									style={step.photoPosition ? `object-position: ${step.photoPosition}` : undefined}
								/>
							) : (
								<div class="photo-placeholder" style={`--n: ${i}`}>
									<Icon name={step.icon} size={56} />
								</div>
							)}
						</div>
					))
				}
			</div>

			<div class="tab-panels">
				{
					steps.map((step, i) => (
						<div
							id={`${id}-panel-${i}`}
							class:list={['tab-panel', { 'is-active': i === 0 }]}
							role="tabpanel"
							aria-labelledby={`${id}-tab-${i}`}
							inert={i !== 0}
							data-panel
						>
							<span class="step-count">
								{String(i + 1).padStart(2, '0')} / {String(steps.length).padStart(2, '0')}
							</span>
							<h3>{step.name}</h3>
							<p>{step.text}</p>
						</div>
					))
				}
			</div>

			<div class="tab-list" role="tablist" aria-label={title} aria-orientation="vertical">
				{
					steps.map((step, i) => (
						<button
							id={`${id}-tab-${i}`}
							class:list={['tab', { 'is-active': i === 0 }]}
							role="tab"
							type="button"
							aria-selected={i === 0 ? 'true' : 'false'}
							aria-controls={`${id}-panel-${i}`}
							tabindex={i === 0 ? 0 : -1}
							data-tab
						>
							{step.name}
							<span class="tab-progress" aria-hidden="true" />
						</button>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	// Vertical tabs that move to the next step on their own, with a progress line on the
	// active tab. Clicking or using the arrow keys picks a tab straight away.
	document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
		const photos = [...root.querySelectorAll<HTMLElement>('[data-photo]')];
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let current = 0;

		const select = (index: number, focus = false) => {
			current = (index + tabs.length) % tabs.length;
			tabs.forEach((tab, i) => {
				const active = i === current;
				tab.classList.toggle('is-active', active);
				tab.setAttribute('aria-selected', String(active));
				tab.tabIndex = active ? 0 : -1;
			});
			panels.forEach((panel, i) => {
				panel.classList.toggle('is-active', i === current);
				panel.inert = i !== current;
			});
			photos.forEach((photo, i) => photo.classList.toggle('is-active', i === current));

			// Restart the progress line on the newly active tab.
			const bar = tabs[current].querySelector<HTMLElement>('.tab-progress');
			if (bar) {
				bar.style.animation = 'none';
				void bar.offsetWidth;
				bar.style.animation = '';
			}
			if (focus) tabs[current].focus();
		};

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => select(i));
			tab.addEventListener('keydown', (event) => {
				const keys: Record<string, number> = {
					ArrowDown: current + 1,
					ArrowRight: current + 1,
					ArrowUp: current - 1,
					ArrowLeft: current - 1,
					Home: 0,
					End: tabs.length - 1,
				};
				if (event.key in keys) {
					event.preventDefault();
					select(keys[event.key], true);
				}
			});
		});

		if (reduceMotion) return;

		// Auto-play: when the active tab's progress line fills up, go to the next tab.
		root.classList.add('is-autoplay');
		root.addEventListener('animationend', (event) => {
			const target = event.target as HTMLElement;
			if (target.classList.contains('tab-progress') && target.closest('.tab.is-active')) {
				select(current + 1);
			}
		});

		// Pause only while the mouse is over one of the tabs.
		tabs.forEach((tab) => {
			tab.addEventListener('mouseenter', () => root.classList.add('is-paused'));
			tab.addEventListener('mouseleave', () => root.classList.remove('is-paused'));
		});
	});
</script>

<style>
	.approach-head {
		margin-bottom: calc(3rem + 20px);
		text-align: center;
	}

	.approach-head h2 {
		font-size: clamp(1.8rem, 3.5vw, 2.4rem);
		margin: 0;
	}

	/* Photo | active step's text | tab list */
	.tabs {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 0.6fr);
		grid-template-areas: 'media panel list';
		gap: 3rem;
		align-items: center;
	}

	/* Photos sit on top of each other and cross-fade */
	.tab-media {
		grid-area: media;
		display: grid;
		/* 3:2 matches most of the photos, so little is cropped */
		aspect-ratio: 3 / 2;
		border-radius: 24px;
		overflow: hidden;
		box-shadow: 0 18px 40px rgba(15, 42, 74, 0.12);
	}

	.tab-photo {
		grid-area: 1 / 1;
		opacity: 0;
		transform: scale(1.04);
		transition:
			opacity 0.6s var(--ease-smooth),
			transform 1.2s var(--ease-smooth);
	}

	.tab-photo.is-active {
		opacity: 1;
		transform: none;
	}

	.tab-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Whole photo shown, centred, over a blurred, darkened copy that fills the frame */
	.tab-photo.is-contain {
		position: relative;
		overflow: hidden;
	}

	.tab-photo.is-contain :global(.photo-fill) {
		position: absolute;
		inset: 0;
		filter: blur(24px) brightness(0.75);
		transform: scale(1.2);
	}

	.tab-photo.is-contain :global(.photo-main) {
		position: relative;
		object-fit: contain;
	}

	/* Until real photos are added: a soft brand gradient with the step's icon */
	.photo-placeholder {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		color: rgba(255, 255, 255, 0.85);
		background: linear-gradient(
			calc(135deg + var(--n) * 25deg),
			var(--accent) 0%,
			var(--navy-light) 100%
		);
	}

	/* Text panels also sit on top of each other and fade between */
	.tab-panels {
		grid-area: panel;
		display: grid;
	}

	.tab-panel {
		grid-area: 1 / 1;
		opacity: 0;
		transform: translateY(12px);
		visibility: hidden;
		transition:
			opacity 0.5s var(--ease-smooth),
			transform 0.5s var(--ease-smooth),
			visibility 0.5s;
	}

	.tab-panel.is-active {
		opacity: 1;
		transform: none;
		visibility: visible;
		transition-delay: 0.1s;
	}

	.step-count {
		display: block;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--accent);
		margin-bottom: 0.75rem;
	}

	.tab-panel h3 {
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		margin: 0 0 1rem;
	}

	.tab-panel p {
		margin: 0;
		font-size: 1.1rem;
		color: var(--text-muted);
	}

	/* Tab list, right-aligned like a menu */
	.tab-list {
		grid-area: list;
		align-self: start;
		display: flex;
		flex-direction: column;
	}

	.tab {
		position: relative;
		padding: 1.1rem 0;
		border: none;
		border-bottom: 1px solid var(--border);
		background: none;
		font: inherit;
		font-size: 1.15rem;
		font-weight: 500;
		text-align: right;
		color: var(--text-muted);
		opacity: 0.7;
		cursor: pointer;
		transition:
			color 0.3s var(--ease-smooth),
			opacity 0.3s var(--ease-smooth);
	}

	.tab:hover {
		opacity: 1;
	}

	.tab.is-active {
		color: var(--navy);
		font-weight: 600;
		opacity: 1;
	}

	/* Progress line along the active tab's bottom border */
	.tab-progress {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: right;
	}

	/* Without auto-play (e.g. reduced motion), the active tab gets a full line */
	.tab.is-active .tab-progress {
		transform: scaleX(1);
	}

	.tabs.is-autoplay .tab.is-active .tab-progress {
		animation: tab-progress var(--interval) linear forwards;
	}

	.tabs.is-paused .tab.is-active .tab-progress {
		animation-play-state: paused;
	}

	@keyframes tab-progress {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	/* Tablets and phones: tabs in a row on top, then the photo, then the text */
	@media (max-width: 900px) {
		.tabs {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: 'list' 'media' 'panel';
			gap: 1.75rem;
		}

		.tab-list {
			flex-direction: row;
			gap: 1.5rem;
			overflow-x: auto;
			scrollbar-width: none;
			border-bottom: 1px solid var(--border);
		}

		.tab-list::-webkit-scrollbar {
			display: none;
		}

		.tab {
			flex-shrink: 0;
			padding: 0.75rem 0;
			font-size: 1rem;
			text-align: left;
			white-space: nowrap;
			border-bottom: none;
		}

		.tab-progress {
			bottom: 0;
			transform-origin: left;
		}
	}
</style>
