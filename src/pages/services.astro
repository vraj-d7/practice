---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/site';

const faqs = [
	{
		q: 'What kinds of businesses do you work with?',
		a: 'We work with businesses of all sizes — from companies making their first international order to established importers and exporters looking for a more reliable partner.',
	},
	{
		q: 'Can you handle just one part of the process?',
		a: 'Yes. You can use us end to end, or only for the parts you need, such as sourcing, freight, or customs documentation.',
	},
	{
		q: 'How do I get a quote?',
		a: 'Send us a message through the contact page with details about your goods, origin, destination, and timeline. We will reply with a tailored proposal.',
	},
	{
		q: 'Will I be able to track my shipment?',
		a: 'Yes. We keep you updated at each key stage of the journey, and you will have a direct contact for any questions.',
	},
];
---

<Layout
	title="Services"
	description="Import and export, sourcing, freight, customs, warehousing, and trade consulting from Edge Global Trade."
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Our services</span>
			<h1>Everything you need to trade globally</h1>
			<p>
				Choose a single service or let us manage the entire journey. Every solution is shaped
				around your goods, your markets, and your timeline.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="filters reveal" role="tablist" aria-label="Service categories">
				<button class="filter active" data-filter="all" role="tab" aria-selected="true">All</button>
				<button class="filter" data-filter="trade" role="tab" aria-selected="false">Trade</button>
				<button class="filter" data-filter="logistics" role="tab" aria-selected="false">
					Logistics
				</button>
				<button class="filter" data-filter="advisory" role="tab" aria-selected="false">
					Advisory
				</button>
			</div>

			<div class="grid-3 services-grid">
				{
					services.map((s) => (
						<article
							id={s.slug}
							class="card service reveal"
							data-category={
								['import-export', 'sourcing'].includes(s.slug)
									? 'trade'
									: ['freight', 'warehousing'].includes(s.slug)
										? 'logistics'
										: 'advisory'
							}
						>
							<div class="icon-box">
								<Icon name={s.icon} />
							</div>
							<h2>{s.title}</h2>
							<p>{s.summary}</p>
							<ul>
								{s.points.map((p) => (
									<li>
										<Icon name="check" size={16} />
										{p}
									</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section-soft">
		<div class="container faq-grid">
			<div class="reveal">
				<span class="eyebrow">FAQ</span>
				<h2>Common questions</h2>
				<p>
					Can’t find what you’re looking for? <a href="/contact">Contact our team</a> and we’ll be
					happy to help.
				</p>
			</div>

			<div class="faq-list reveal">
				{
					faqs.map((f, i) => (
						<details class="faq" open={i === 0}>
							<summary>
								{f.q}
								<span class="faq-icon" aria-hidden="true" />
							</summary>
							<p>{f.a}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class="section cta-section">
		<div class="container">
			<div class="cta-band reveal">
				<h2>Not sure which service you need?</h2>
				<p>Tell us about your goals and we’ll recommend the right approach.</p>
				<a href="/contact" class="btn btn-white">Request a quote</a>
			</div>
		</div>
	</section>
</Layout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
	const cards = document.querySelectorAll<HTMLElement>('.service');

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter;
			buttons.forEach((b) => {
				const active = b === button;
				b.classList.toggle('active', active);
				b.setAttribute('aria-selected', String(active));
			});
			cards.forEach((card) => {
				const show = filter === 'all' || card.dataset.category === filter;
				card.classList.toggle('hidden', !show);
			});
		});
	});

	// Only keep one FAQ open at a time.
	const faqs = document.querySelectorAll<HTMLDetailsElement>('.faq');
	faqs.forEach((faq) => {
		faq.addEventListener('toggle', () => {
			if (faq.open) faqs.forEach((other) => other !== faq && (other.open = false));
		});
	});
</script>

<style>
	.filters {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 3rem;
	}

	.filter {
		font: inherit;
		font-weight: 600;
		padding: 0.6rem 1.4rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: #fff;
		color: var(--text-muted);
		cursor: pointer;
		transition: all 0.2s;
	}

	.filter:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.filter.active {
		background: var(--navy);
		border-color: var(--navy);
		color: #fff;
	}

	.service.hidden {
		display: none;
	}

	.service:target {
		border-color: var(--accent);
		box-shadow: var(--shadow);
	}

	.service h2 {
		font-size: 1.25rem;
		margin: 0 0 0.5rem;
	}

	.service > p {
		color: var(--text-muted);
		margin: 0 0 1.25rem;
	}

	.service ul {
		list-style: none;
		margin: 0;
		padding: 1.25rem 0 0;
		border-top: 1px solid var(--border);
		display: grid;
		gap: 0.6rem;
	}

	.service li {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.95rem;
	}

	.service li :global(svg) {
		flex-shrink: 0;
		color: var(--accent);
	}

	.faq-grid {
		display: grid;
		grid-template-columns: 1fr 1.6fr;
		gap: 4rem;
		align-items: start;
	}

	.faq-grid h2 {
		font-size: clamp(1.8rem, 3.5vw, 2.4rem);
		margin: 0 0 1rem;
	}

	.faq-grid > div > p {
		color: var(--text-muted);
	}

	.faq-grid a {
		color: var(--accent);
		font-weight: 600;
	}

	.faq-list {
		display: grid;
		gap: 1rem;
	}

	.faq {
		background: #fff;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		transition: border-color 0.2s;
	}

	.faq[open] {
		border-color: var(--accent);
	}

	.faq summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 1.25rem 1.5rem;
		font-weight: 600;
		color: var(--navy);
		cursor: pointer;
		list-style: none;
	}

	.faq summary::-webkit-details-marker {
		display: none;
	}

	.faq-icon {
		position: relative;
		flex-shrink: 0;
		width: 14px;
		height: 14px;
	}

	.faq-icon::before,
	.faq-icon::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 0;
		width: 100%;
		height: 2px;
		background: var(--accent);
		transition: transform 0.25s;
	}

	.faq-icon::after {
		transform: rotate(90deg);
	}

	.faq[open] .faq-icon::after {
		transform: rotate(0);
	}

	.faq p {
		margin: 0;
		padding: 0 1.5rem 1.25rem;
		color: var(--text-muted);
	}

	.cta-section {
		padding-top: 0;
	}

	@media (max-width: 900px) {
		.faq-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
