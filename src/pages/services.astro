---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { services } from '../data/site';
---

<Layout
	title="Services"
	description="Import and export, sourcing, freight, customs, warehousing, and trade consulting from Edge Global Trade."
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Our services</span>
			<h1>Everything you need to trade globally</h1>
			<p>
				Choose a single service or let us manage the entire journey. Every solution is shaped
				around your goods, your markets, and your timeline.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="filters reveal" role="tablist" aria-label="Service categories">
				<button class="filter active" data-filter="all" role="tab" aria-selected="true">All</button>
				<button class="filter" data-filter="trade" role="tab" aria-selected="false">Trade</button>
				<button class="filter" data-filter="logistics" role="tab" aria-selected="false">
					Logistics
				</button>
				<button class="filter" data-filter="advisory" role="tab" aria-selected="false">
					Advisory
				</button>
			</div>

			<div class="grid-3 services-grid">
				{
					services.map((s) => (
						<article
							id={s.slug}
							class="card service reveal"
							data-category={
								['import-export', 'sourcing'].includes(s.slug)
									? 'trade'
									: ['freight', 'warehousing'].includes(s.slug)
										? 'logistics'
										: 'advisory'
							}
						>
							<div class="icon-box">
								<Icon name={s.icon} />
							</div>
							<h2>{s.title}</h2>
							<p>{s.summary}</p>
							<ul>
								{s.points.map((p) => (
									<li>
										<Icon name="check" size={16} />
										{p}
									</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<Faq />

	<section class="section cta-section">
		<div class="container">
			<div class="cta-band reveal">
				<h2>Not sure which service you need?</h2>
				<p>Tell us about your goals and we’ll recommend the right approach.</p>
				<a href="/contact" class="btn btn-white">Request a quote</a>
			</div>
		</div>
	</section>
</Layout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
	const cards = document.querySelectorAll<HTMLElement>('.service');

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter;
			buttons.forEach((b) => {
				const active = b === button;
				b.classList.toggle('active', active);
				b.setAttribute('aria-selected', String(active));
			});
			cards.forEach((card) => {
				const show = filter === 'all' || card.dataset.category === filter;
				card.classList.toggle('hidden', !show);
			});
		});
	});
</script>

<style>
	.filters {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 3rem;
	}

	.filter {
		font: inherit;
		font-weight: 600;
		padding: 0.6rem 1.4rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: #fff;
		color: var(--text-muted);
		cursor: pointer;
		transition: all 0.2s;
	}

	.filter:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.filter.active {
		background: var(--navy);
		border-color: var(--navy);
		color: #fff;
	}

	.service.hidden {
		display: none;
	}

	.service:target {
		border-color: var(--accent);
		box-shadow: var(--shadow);
	}

	.service h2 {
		font-size: 1.25rem;
		margin: 0 0 0.5rem;
	}

	.service > p {
		color: var(--text-muted);
		margin: 0 0 1.25rem;
	}

	.service ul {
		list-style: none;
		margin: 0;
		padding: 1.25rem 0 0;
		border-top: 1px solid var(--border);
		display: grid;
		gap: 0.6rem;
	}

	.service li {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.95rem;
	}

	.service li :global(svg) {
		flex-shrink: 0;
		color: var(--accent);
	}
</style>
