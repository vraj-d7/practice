---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ScrollRevealText from '../components/ScrollRevealText.astro';
import { services } from '../data/site';

const reasons = [
	{
		icon: 'shield',
		title: 'Quality Assurance',
		text: 'Rigorous quality control processes to ensure all products consistently meet international standards and client expectations.',
	},
	{
		icon: 'tag',
		title: 'Competitive Pricing',
		text: 'Competitive market pricing supported by transparent practices and fair, trustworthy business dealings.',
	},
	{
		icon: 'globe',
		title: 'Global Logistics',
		text: 'Seamless shipping and logistics management for efficient and hassle-free delivery to destinations worldwide.',
	},
	{
		icon: 'box',
		title: 'Reliable Supply',
		text: 'Consistent and timely delivery ensured through strong coordination and reliable, long-term partnerships.',
	},
] as const;

const steps = [
	{ title: 'Tell us your needs', text: 'Share what you want to source, ship, or sell.' },
	{ title: 'Get a tailored plan', text: 'We propose routes, partners, timelines, and costs.' },
	{ title: 'We handle the details', text: 'Paperwork, freight, and customs taken care of.' },
	{ title: 'Delivered & tracked', text: 'Your goods arrive with updates along the way.' },
];
---

<Layout>
	<section class="hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<span class="eyebrow">International trade, simplified</span>
				<h1>Your Trusted business partner for <span class="highlight">global trade</span></h1>
				<p>
					Edge Global Trade helps companies source products, move goods across borders, and
					reach new customers worldwide — with one reliable partner managing every step.
				</p>
				<div class="hero-actions">
					<a href="/contact" class="btn btn-primary">
						Get a quote <Icon name="arrow" size={18} />
					</a>
					<a href="/services" class="btn btn-ghost">Explore services</a>
				</div>
			</div>

			<div class="hero-visual" aria-hidden="true">
				<div class="route-card">
					<div class="route-head">
						<span class="dot live"></span> Shipment in transit
					</div>
					<ol class="route">
						<li class="stop">
							<span class="stop-dot"></span>
							<span class="stop-text">
								<strong>Origin</strong>
								<small>Packed & dispatched</small>
							</span>
							<span class="route-line"><span class="route-progress"></span></span>
						</li>
						<li class="stop">
							<span class="stop-dot"></span>
							<span class="stop-text">
								<strong>Customs</strong>
								<small>Cleared</small>
							</span>
							<span class="route-line"><span class="route-progress delay"></span></span>
						</li>
						<li class="stop">
							<span class="stop-dot pending"></span>
							<span class="stop-text">
								<strong>Destination</strong>
								<small>On the way</small>
							</span>
						</li>
					</ol>
				</div>
				<div class="float-card float-a">
					<Icon name="ship" size={20} /> Sea · Air · Land
				</div>
				<div class="float-card float-b">
					<Icon name="shield" size={20} /> Compliance handled
				</div>
			</div>
		</div>
	</section>

	<ScrollRevealText
		link={{ href: '/about', label: 'About Us' }}
		lead="Edge Global Trade"
		text="remains well connected Export and Import Company offering quality industrial products sourced from India and elsewhere to international buyers. We offer cutting edge services in terms of sourcing products meeting ASTM and international standards with competitive terms and long term engagement commitments."
	/>

	<section class="section">
		<div class="container">
			<div class="section-head reveal">
				<span class="eyebrow">What we do</span>
				<h2>Services that keep trade moving</h2>
				<p>From finding the right supplier to delivering at the destination, we cover the full journey.</p>
			</div>

			<div class="grid-3">
				{
					services.slice(0, 3).map((s) => (
						<a href={`/services#${s.slug}`} class="card service-card reveal">
							<div class="icon-box">
								<Icon name={s.icon} />
							</div>
							<h3>{s.title}</h3>
							<p>{s.summary}</p>
							<span class="card-link">
								Learn more <Icon name="arrow" size={16} />
							</span>
						</a>
					))
				}
			</div>

			<div class="center reveal">
				<a href="/services" class="btn btn-primary">View all services</a>
			</div>
		</div>
	</section>

	<section class="section section-soft">
		<div class="container why-grid">
			<div class="why-copy">
				<span class="eyebrow reveal" style="--i: 0">Why Edge Global Trade</span>
				<h2 class="reveal" style="--i: 1">A trade partner you can rely on</h2>
				<p class="reveal" style="--i: 2">
					International trade involves many moving parts. We bring them together so your
					business can grow in new markets with confidence and less complexity.
				</p>
				<a href="/about" class="btn btn-primary reveal" style="--i: 3">About us</a>
			</div>

			<div class="why-list">
				{
					reasons.map((r, i) => (
						<div class="why-item reveal" style={`--i: ${i}`}>
							<div class="why-top">
								<span class="why-icon">
									<Icon name={r.icon} size={24} />
								</span>
								<span class="why-num">{String(i + 1).padStart(2, '0')}</span>
							</div>
							<h3>{r.title}</h3>
							<p>{r.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head reveal">
				<span class="eyebrow">How it works</span>
				<h2>Four simple steps</h2>
				<p>A clear process from first conversation to final delivery.</p>
			</div>

			<ol class="steps">
				{
					steps.map((step, i) => (
						<li class="step reveal" style={`--i: ${i}`}>
							<span class="step-num">{String(i + 1).padStart(2, '0')}</span>
							<h3>{step.title}</h3>
							<p>{step.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<Faq />

	<CtaBanner
		title="Ready to take your business global?"
		text="Tell us what you need to move, and we'll build a plan to get it there."
		button={{ href: '/contact', label: 'Contact our team' }}
	/>
</Layout>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(circle at 85% 20%, rgba(31, 122, 224, 0.12), transparent 45%),
			linear-gradient(180deg, #fff 0%, var(--bg-soft) 100%);
		padding: 5.5rem 0 6rem;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.hero h1 {
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		margin: 0 0 1.25rem;
	}

	.highlight {
		color: var(--accent);
	}

	/* Page-load entrance: the label, headline, intro, and buttons rise in one after another */
	.hero-copy > * {
		animation: rise 0.9s var(--ease-smooth) both;
	}

	.hero-copy > :nth-child(1) {
		animation-delay: 0.05s;
	}
	.hero-copy > :nth-child(2) {
		animation-delay: 0.15s;
	}
	.hero-copy > :nth-child(3) {
		animation-delay: 0.25s;
	}
	.hero-copy > :nth-child(4) {
		animation-delay: 0.35s;
	}

	.hero-copy p {
		font-size: 1.15rem;
		color: var(--text-muted);
		max-width: 540px;
		margin: 0 0 2.25rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.btn-ghost {
		border-color: var(--border);
		color: var(--navy);
		background: #fff;
	}

	.btn-ghost:hover {
		border-color: var(--navy);
	}

	/* Hero visual */
	.hero-visual {
		position: relative;
		padding: 2rem 0;
	}

	.route-card {
		background: #fff;
		border-radius: 16px;
		box-shadow: 0 20px 50px rgba(15, 42, 74, 0.12);
		padding: 2rem;
		animation: rise 0.9s 0.45s var(--ease-smooth) both;
	}

	.route-head {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		color: var(--navy);
		margin-bottom: 2rem;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #22a06b;
	}

	.dot.live {
		animation: pulse 1.8s infinite;
	}

	/* Three equal columns so the dots, and the lines between them, are evenly spaced */
	.route {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.stop {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.6rem;
		font-size: 0.9rem;
	}

	.stop-text {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.stop small {
		color: var(--text-muted);
		font-size: 0.78rem;
	}

	.stop-dot {
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: var(--accent);
		border: 4px solid var(--accent-soft);
	}

	.stop-dot.pending {
		background: #fff;
		border-color: var(--border);
	}

	/* Runs from just right of this dot to just left of the next dot */
	.route-line {
		position: absolute;
		top: 7.5px;
		left: calc(50% + 17px);
		width: calc(100% - 34px);
		height: 3px;
		background: var(--border);
		border-radius: 3px;
		overflow: hidden;
	}

	.route-progress {
		position: absolute;
		inset: 0;
		background: var(--accent);
		transform-origin: left;
		animation: fill 1.4s 0.4s ease both;
	}

	.route-progress.delay {
		animation: fill-half 1.4s 1.6s ease both;
	}

	.float-card {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: #fff;
		border-radius: 10px;
		box-shadow: var(--shadow);
		padding: 0.7rem 1rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--navy);
		/* Draw each tag once as its own layer and slide that, so the text moves smoothly
		   with the box instead of being redrawn (and jittering) at every position */
		will-change: transform;
		backface-visibility: hidden;
	}

	.float-card :global(svg) {
		color: var(--accent);
	}

	/* The tags pop in after the main card has risen in (it finishes at ~1.35s): the top
	   one drops down from above, then the bottom one rises from below. Once in place,
	   they start their gentle floating loop. */
	.float-a {
		top: -0.5rem;
		right: 1.5rem;
		animation:
			tag-in-down 0.7s var(--ease-smooth) 1.1s both,
			float 5s ease-in-out 1.8s infinite;
	}

	.float-b {
		bottom: -0.5rem;
		left: 1.5rem;
		animation:
			tag-in-up 0.7s var(--ease-smooth) 1.3s both,
			float 5s ease-in-out 3.3s infinite;
	}

	@keyframes tag-in-down {
		from {
			opacity: 0;
			transform: translateY(-14px) scale(0.92);
		}
	}

	@keyframes tag-in-up {
		from {
			opacity: 0;
			transform: translateY(14px) scale(0.92);
		}
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
	}

	@keyframes fill {
		from {
			transform: scaleX(0);
		}
	}

	@keyframes fill-half {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(0.55);
		}
	}

	@keyframes fill-down {
		from {
			transform: scaleY(0);
		}
	}

	@keyframes fill-half-down {
		from {
			transform: scaleY(0);
		}
		to {
			transform: scaleY(0.55);
		}
	}

	@keyframes pulse {
		0% {
			box-shadow: 0 0 0 0 rgba(34, 160, 107, 0.5);
		}
		100% {
			box-shadow: 0 0 0 10px rgba(34, 160, 107, 0);
		}
	}

	@keyframes float {
		0%,
		100% {
			transform: translate3d(0, 0, 0);
		}
		50% {
			transform: translate3d(0, -8px, 0);
		}
	}

	/* Services preview */
	.service-card {
		display: flex;
		flex-direction: column;
	}

	.service-card h3 {
		margin: 0 0 0.5rem;
		font-size: 1.2rem;
	}

	.service-card p {
		margin: 0 0 1.5rem;
		color: var(--text-muted);
		flex: 1;
	}

	.card-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 600;
		color: var(--accent);
	}

	.card-link :global(svg) {
		transition: transform 0.5s var(--ease-smooth);
	}

	.service-card:hover .card-link :global(svg) {
		transform: translateX(4px);
	}

	.center {
		text-align: center;
		margin-top: 3rem;
	}

	/* Why us */
	.why-grid {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 4rem;
		align-items: center;
	}

	.why-copy h2 {
		font-size: clamp(1.8rem, 3.5vw, 2.5rem);
		margin: 0 0 1rem;
	}

	.why-copy p {
		color: var(--text-muted);
		font-size: 1.1rem;
		margin: 0 0 2rem;
	}

	/* Same rise-in as the top banner, one item after another, triggered on scroll.
	   The button's own hover transitions are kept in the list. */
	.why-copy > .reveal {
		transition:
			opacity 0.9s var(--ease-smooth) calc(var(--i, 0) * 0.1s),
			transform 0.9s var(--ease-smooth) calc(var(--i, 0) * 0.1s),
			background 0.2s,
			color 0.2s,
			box-shadow 0.2s;
	}

	/* Keep the button's hover lift once it has faded in */
	.why-copy > .btn.visible:hover {
		transform: translateY(-2px);
	}

	.why-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.why-item {
		position: relative;
		overflow: hidden;
		background: #fff;
		border-radius: 16px;
		padding: 1.75rem;
		border: 1px solid var(--border);
		box-shadow: 0 2px 8px rgba(15, 42, 74, 0.04);
		/* Fade up on scroll, each card a little after the one before it */
		transition:
			opacity 0.7s var(--ease-smooth) calc(var(--i, 0) * 0.15s),
			transform 0.6s var(--ease-smooth) calc(var(--i, 0) * 0.15s),
			box-shadow 0.3s ease,
			border-color 0.3s ease;
	}

	/* Accent bar that grows across the top on hover */
	.why-item::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: linear-gradient(90deg, var(--accent), #8cc2ff);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.35s ease;
	}

	/* Stagger the right-hand column for a less boxy layout */
	.why-item:nth-child(even) {
		margin-top: 2rem;
		margin-bottom: -2rem;
	}

	.why-item.visible:hover {
		transform: translateY(-6px);
		border-color: transparent;
		box-shadow: 0 18px 40px rgba(15, 42, 74, 0.12);
	}

	.why-item:hover::before {
		transform: scaleX(1);
	}

	.why-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 1.25rem;
	}

	.why-icon {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 14px;
		background: linear-gradient(135deg, var(--accent) 0%, var(--navy-light) 100%);
		color: #fff;
		box-shadow: 0 8px 18px rgba(31, 122, 224, 0.28);
		transition: transform 0.3s ease;
	}

	.why-item:hover .why-icon {
		transform: rotate(-6deg) scale(1.06);
	}

	.why-num {
		font-size: 1.6rem;
		font-weight: 800;
		line-height: 1;
		color: var(--accent-soft);
		transition: color 0.3s ease;
	}

	.why-item:hover .why-num {
		color: #b5d4f4;
	}

	.why-item h3 {
		font-size: 1.1rem;
		margin: 0 0 0.5rem;
	}

	.why-item p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	/* Steps */
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
		counter-reset: step;
	}

	.step {
		position: relative;
		padding: 2rem 1.5rem;
		border-top: 3px solid var(--border);
		/* Fade up on scroll, each card a little after the one before it */
		transition:
			opacity 0.8s var(--ease-smooth) calc(var(--i, 0) * 0.15s),
			transform 0.8s var(--ease-smooth) calc(var(--i, 0) * 0.15s),
			border-color 0.3s;
	}

	.step:hover {
		border-color: var(--accent);
	}

	.step-num {
		display: block;
		font-size: 2rem;
		font-weight: 800;
		color: var(--accent);
		opacity: 0.35;
		margin-bottom: 0.5rem;
		transition: opacity 0.3s;
	}

	.step:hover .step-num {
		opacity: 1;
	}

	.step h3 {
		font-size: 1.1rem;
		margin: 0 0 0.5rem;
	}

	.step p {
		margin: 0;
		color: var(--text-muted);
	}

	/* Below 720px: switch the tracker to a vertical timeline */
	@media (max-width: 719.98px) {
		.route {
			grid-template-columns: 1fr;
		}

		.stop {
			flex-direction: row;
			align-items: flex-start;
			text-align: left;
			gap: 1rem;
			padding-bottom: 1.5rem;
		}

		.stop:last-child {
			padding-bottom: 0;
		}

		.stop-dot {
			margin-top: 2px;
		}

		.stop-text {
			gap: 0.1rem;
		}

		/* Runs from just below this dot to just above the next dot */
		.route-line {
			top: 24px;
			left: 7.5px;
			width: 3px;
			height: calc(100% - 26px);
		}

		.route-progress {
			transform-origin: top;
			animation-name: fill-down;
		}

		.route-progress.delay {
			animation-name: fill-half-down;
		}
	}

	/* Up to 1280px there isn't room for the text and cards side by side: the text is
	   centred on top, with the cards two by two below it */
	@media (max-width: 1280px) {
		.why-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.why-copy {
			text-align: center;
		}

		.why-copy p {
			max-width: 640px;
			margin-left: auto;
			margin-right: auto;
		}

		.why-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			width: 100%;
			max-width: 880px;
			margin: 0 auto;
		}
	}

	@media (max-width: 900px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.steps {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.hero {
			padding: 3.5rem 0 4.5rem;
		}

		.why-item:nth-child(even) {
			margin: 0;
		}

		.why-list,
		.steps {
			grid-template-columns: 1fr;
		}

		.route-card {
			padding: 1.5rem 1rem;
		}

		.float-card {
			font-size: 0.8rem;
		}
	}
</style>
