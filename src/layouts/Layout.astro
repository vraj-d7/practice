---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import 'lenis/dist/lenis.css';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />

		<script>
			import Lenis from 'lenis';

			// Smooth wheel and trackpad scrolling. Touch scrolling stays native, and
			// people who prefer reduced motion get normal scrolling.
			const lenis = new Lenis({
				autoRaf: true,
				lerp: 0.1,
				anchors: true,
			});

			// Glide to same-page links written with a path, like "/services#customs".
			document.addEventListener('click', (event) => {
				const link = (event.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
				if (!link || link.pathname !== location.pathname || !link.hash) return;
				const target = document.querySelector(link.hash);
				if (!target) return;
				event.preventDefault();
				lenis.scrollTo(target as HTMLElement);
				history.pushState(null, '', link.hash);
			});

			// Pause smooth scrolling while the mobile menu is open.
			const root = document.documentElement;
			new MutationObserver(() => {
				const menuOpen = root.classList.contains('menu-open');
				if (menuOpen && !lenis.isStopped) lenis.stop();
				else if (!menuOpen && lenis.isStopped) lenis.start();
			}).observe(root, { attributes: true, attributeFilter: ['class'] });
		</script>

		<script>
			// Fade sections in as they scroll into view.
			const items = document.querySelectorAll<HTMLElement>('.reveal');

			// Once a staggered item has appeared, drop its delay (--i) so hover effects
			// that use the same transitions respond straight away.
			const clearStagger = (el: HTMLElement) => {
				if (!el.style.getPropertyValue('--i')) return;
				const onEnd = (event: TransitionEvent) => {
					// Ignore transitions bubbling up from child elements.
					if (event.target !== el) return;
					el.style.setProperty('--i', '0');
					el.removeEventListener('transitionend', onEnd);
				};
				el.addEventListener('transitionend', onEnd);
			};

			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								const el = entry.target as HTMLElement;
								el.classList.add('visible');
								clearStagger(el);
								observer.unobserve(el);
							}
						});
					},
					{ threshold: 0.12 },
				);
				items.forEach((el) => observer.observe(el));
			} else {
				items.forEach((el) => el.classList.add('visible'));
			}
		</script>
	</body>
</html>
