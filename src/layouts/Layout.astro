---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, socialLinks } from '../data/site';
import 'lenis/dist/lenis.css';
import '../styles/global.css';

interface Props {
	/** Page name, shown as "Name | Edge Global Trade" */
	title?: string;
	/** Use this exact text as the page title instead */
	fullTitle?: string;
	/** Header floats transparently over the page's top section (Home page video) */
	headerOverlay?: boolean;
	description?: string;
}

const { title, fullTitle, description = site.description, headerOverlay = false } = Astro.props;
const pageTitle = fullTitle ?? (title ? `${title} | ${site.name}` : site.name);

// The one official address for this page: always https://edgeglobaltrade.com (never www),
// with a trailing slash, since that's the address the live site serves (/about → /about/)
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;
// "?v=2": bump this number whenever og-image.png changes, so WhatsApp, LinkedIn, etc.
// fetch the new image instead of reusing the one they saved
const shareImage = new URL('/og-image.png?v=2', Astro.site).href;

// Tells search engines who the business is: name, logo, contact details, and profiles
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${Astro.site}#organization`,
			name: site.name,
			url: Astro.site?.href,
			logo: new URL('/logo.png', Astro.site).href,
			description: site.description,
			email: site.email,
			contactPoint: site.phones.map((telephone) => ({
				'@type': 'ContactPoint',
				telephone,
				email: site.email,
				contactType: 'customer service',
			})),
			sameAs: socialLinks.map((link) => link.href).filter((href) => href.startsWith('http')),
		},
		{
			'@type': 'WebSite',
			'@id': `${Astro.site}#website`,
			name: site.name,
			url: Astro.site?.href,
			publisher: { '@id': `${Astro.site}#organization` },
		},
	],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />

		<!-- Icons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0f2a4a" />

		<!-- Link previews (WhatsApp, LinkedIn, Facebook, X, etc.) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={shareImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${site.name}, your trusted business partner for global trade`} />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImage} />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<Header overlay={headerOverlay} />
		<main id="main">
			<slot />
		</main>
		<Footer />

		<script>
			import Lenis from 'lenis';

			// Smooth wheel and trackpad scrolling. Touch scrolling stays native, and
			// people who prefer reduced motion get normal scrolling.
			const lenis = new Lenis({
				autoRaf: true,
				lerp: 0.1,
				anchors: true,
			});

			// Glide to same-page links written with a path, like "/services#customs".
			document.addEventListener('click', (event) => {
				const link = (event.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
				if (!link || link.pathname !== location.pathname || !link.hash) return;
				const target = document.querySelector(link.hash);
				if (!target) return;
				event.preventDefault();
				lenis.scrollTo(target as HTMLElement);
				history.pushState(null, '', link.hash);
			});

			// Pause smooth scrolling while the mobile menu is open.
			const root = document.documentElement;
			new MutationObserver(() => {
				const menuOpen = root.classList.contains('menu-open');
				if (menuOpen && !lenis.isStopped) lenis.stop();
				else if (!menuOpen && lenis.isStopped) lenis.start();
			}).observe(root, { attributes: true, attributeFilter: ['class'] });
		</script>

		<script>
			// Fade sections in as they scroll into view.
			const items = document.querySelectorAll<HTMLElement>('.reveal');

			// Once a staggered item has appeared, drop its delay (--i) so hover effects
			// that use the same transitions respond straight away.
			const clearStagger = (el: HTMLElement) => {
				if (!el.style.getPropertyValue('--i')) return;
				const onEnd = (event: TransitionEvent) => {
					// Ignore transitions bubbling up from child elements.
					if (event.target !== el) return;
					el.style.setProperty('--i', '0');
					el.removeEventListener('transitionend', onEnd);
				};
				el.addEventListener('transitionend', onEnd);
			};

			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								const el = entry.target as HTMLElement;
								el.classList.add('visible');
								clearStagger(el);
								observer.unobserve(el);
							}
						});
					},
					{ threshold: 0.12 },
				);
				items.forEach((el) => observer.observe(el));
			} else {
				items.forEach((el) => el.classList.add('visible'));
			}
		</script>
	</body>
</html>
